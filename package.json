{
  "name": "atril-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lector de partituras 100 % local para iPad: versión web (GitHub Pages, iOS 13+) y local (iOS 10.3.3)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --web",
    "serve": "node server/serve.mjs",
    "check": "node scripts/check.mjs",
    "check:web": "node scripts/check.mjs --web",
    "pruebas": "node scripts/make-test-pdfs.mjs",
    "test": "node test/e2e.mjs",
    "test:web": "node test/web.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/preset-env": "8.0.7",
    "es-check": "9.9.0",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "2.8.335",
    "puppeteer-core": "25.18.1"
  }
}
